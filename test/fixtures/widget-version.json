    "definition": {
      "languageVersion": 1,
      "catalogVersion": 1,
      "source": "<Card title={title} size=\"md\">\n  <State name=\"choosing\">\n    <Row gap=\"sm\" wrap>\n      {slots.map((slot) => (\n        <Button key={slot.id}\n          variant={slot.id === variables.selectedSlot ? \"default\" : \"outline\"}\n          selected={slot.id === variables.selectedSlot}\n          onClick=\"pickSlot\" inputs={{ slotId: slot.id }} disabled={!slot.available}>\n          {slot.label}\n        </Button>\n      ))}\n    </Row>\n    {slots.length === 0 && <Caption>No times available. Ask for another day.</Caption>}\n    {slots.length > 0 && <Button width=\"full\" onClick=\"bookSlot\"\n      inputs={{ slotId: variables.selectedSlot }} disabled={!variables.selectedSlot}>Confirm booking</Button>}\n  </State>\n  <State name=\"booked\">\n    <Row gap=\"xs\" align=\"center\">\n      <Icon name=\"check\" color=\"success\" />\n      <Text weight=\"medium\">Booked for {variables.bookedLabel}</Text>\n    </Row>\n  </State>\n</Card>",
      "schemaSource": "z.object({\n  title: z.string().default(\"Pick a time\"),\n  slots: z.array(z.object({\n    id: z.string(),\n    label: z.string().describe(\"Formatted time. Include the date and time zone in the card title.\"),\n    available: z.boolean().default(true),\n  })).max(50),\n})",
